{
  "schemaVersion": "0.1",
  "id": "community.pdf.borderless-multiline-table.v1",
  "title": "Extract a borderless table with multiline cells from a digital PDF",
  "objective": "Convert the visually aligned table into CSV without absorbing surrounding prose and while preserving wrapped cell values.",
  "input": {
    "path": "fixtures/pdf-borderless-multiline/input.pdf",
    "mediaType": "application/pdf",
    "sha256": "a15cb269ab5ffe800c5b1685875599f722324e54804f3abbce8a5fda2c476a12",
    "pageIndex": 0,
    "tableStyle": "borderless",
    "bboxPoints": [65, 145, 510, 295]
  },
  "expected": {
    "path": "fixtures/pdf-borderless-multiline/expected.csv",
    "mediaType": "text/csv",
    "sha256": "65791570e83a886769ac07b7a18f44dac63f3701220a656114e3fdce83a882b3"
  },
  "constraints": {
    "networkAllowed": false,
    "maxDurationSeconds": 30,
    "maxMemoryMiB": 512
  },
  "assertions": [
    {"metric": "cellAccuracy", "operator": "gte", "value": 1.0},
    {"metric": "rowCount", "operator": "eq", "value": 5},
    {"metric": "columnCount", "operator": "eq", "value": 6}
  ],
  "provenance": {
    "creator": "ToolCommons community fixture",
    "license": "CC0-1.0"
  }
}
